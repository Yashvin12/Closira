# ==========================================
# Closira Workspace - Master .gitignore
# Covers both Frontend (React Native/Expo) and Backend (FastAPI/Python)
# ==========================================

# ── SYSTEM & OS ───────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.pem

# ── IDEs & EDITORS ────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# ── PYTHON & FASTAPI (BACKEND) ────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nosexy
.nosetests

# Database
backend/closira.db
backend/test_closira.db
*.db
*.sqlite
*.sqlite3

# ── REACT NATIVE & EXPO (FRONTEND) ────────
# Dependencies
frontend/node_modules/
node_modules/

# Expo
frontend/.expo/
.expo/
frontend/dist/
frontend/web-build/
expo-env.d.ts

# Native builds
frontend/ios/
frontend/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Typescript
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── PACKAGE MANAGERS ──────────────────────
# Uncomment if you prefer to lock via package-lock.json only:
# yarn.lock
# pnpm-lock.yaml

# ── ENVIRONMENT VARIABLES ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# ── PERSONAL UTILITY FILES ────────────────
commands.sh

# ── AI / AGENT TOOLING ────────────────────
.gemini/
.cursor/
.aider*
.copilot/
